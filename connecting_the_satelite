import pgzrun
import random
WIDTH = 1000
HEIGHT = 500
TITLE = "Connecting the satelite"

satelites = []
next_satelite = 0
number_of_satelite = 8
lines = []
for i in range(8):
    satelite = Actor("satelite")
    x = random.randint(0,WIDTH - 50)
    y = random.randint(0,HEIGHT - 50)
    satelite.pos = (x,y)
    satelites.append(satelite)
    
def draw():
    number = 1
    for satelite in satelites:
         satelite.draw()
         print(satelite.pos)
         screen.draw.text(str(number), (satelite.pos[0], satelite.pos[1]+15)) 
         number = number +1  
    for mihika in  lines:      
        # mihika is holding the coordinates starting and ending
        screen.draw.line(mihika[0], mihika [1], color = "white")     


def on_mouse_down(pos):
    global next_satelite, number_of_satelite, lines
    if next_satelite < number_of_satelite:
        # character.collidepoint(pos)
        if satelites[next_satelite].collidepoint(pos):
            if next_satelite:
                lines.append((satelites[next_satelite -1].pos,satelites[next_satelite].pos))
            next_satelite = next_satelite +1
        else:
            lines = []
            next_satelite = 0
    



pgzrun.go()